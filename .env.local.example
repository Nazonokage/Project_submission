# Neon PostgreSQL connection strings (from Neon dashboard -> Project-Submissions)
DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Gmail App Password for sending OTP emails to professors
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# JWT Secret for signing professor and student session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="your-32-byte-base64-encoded-secret"

# Separate 32-byte base64 AES key for professor password display/export.
# Generate once with the command above; retain it across releases and backups.
STUDENT_PASSWORD_KEY="your-separate-32-byte-base64-encoded-key"

# Optional canonical public origin behind a reverse proxy, e.g. https://projects.example.edu
# APP_ORIGIN="https://projects.example.edu"
